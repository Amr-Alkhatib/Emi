# Copy this file to ".env" (setup.bat does it for you) and paste your key after the =
# Gemini API key: https://aistudio.google.com/apikey
# This file stays on your PC. Never share it or upload it anywhere.
GEMINI_API_KEY=

# Optional: only if you switch brain.provider to claude (Claude API credit is billed separately).
# The Claude helper (Claude Code) does NOT need this — it uses your Claude plan login.
ANTHROPIC_API_KEY=

# Optional: ElevenLabs voices (incl. a clone of your own voice) — https://elevenlabs.io
ELEVENLABS_API_KEY=
